#!/bin/bash
# Post-installation script for Capybara VPN
# This runs with root privileges after package installation

set -e

INSTALL_DIR="/usr/local/bin"
APP_DIR="/Applications"
USER_HOME=$(eval echo ~${SUDO_USER})
APP_SUPPORT="$USER_HOME/Library/Application Support/CapybaraVPN"

echo "Installing Capybara VPN..."

# Create /usr/local/bin if it doesn't exist (common on fresh macOS installs)
if [ ! -d "$INSTALL_DIR" ]; then
    echo "  Creating $INSTALL_DIR directory..."
    mkdir -p "$INSTALL_DIR"
    chmod 755 "$INSTALL_DIR"
fi

# Create application support directory
mkdir -p "$APP_SUPPORT"
chown ${SUDO_USER}:staff "$APP_SUPPORT"

# Move configs to application support (they're in /tmp/capybara-vpn-install/)
if [ ! -d "/tmp/capybara-vpn-install" ]; then
    echo "  ❌ ERROR: Config directory not found!"
    echo "     Expected: /tmp/capybara-vpn-install/"
    echo "     This installer package may be corrupted."
    exit 1
fi

# Validate config.txt exists
if [ ! -f "/tmp/capybara-vpn-install/config.txt" ]; then
    echo "  ❌ ERROR: config.txt not found!"
    exit 1
fi

USERNAME=$(cat /tmp/capybara-vpn-install/config.txt)
echo "Installing VPN configuration for user: $USERNAME"

# Copy username config
cp /tmp/capybara-vpn-install/config.txt "$APP_SUPPORT/"

# Find and validate WireGuard config
WG_CONF=$(ls /tmp/capybara-vpn-install/*_wireguard.conf 2>/dev/null | head -n1)
if [ -z "$WG_CONF" ]; then
    echo "  ❌ ERROR: WireGuard config not found!"
    echo "     Expected: /tmp/capybara-vpn-install/${USERNAME}_wireguard.conf"
    exit 1
fi

# Validate config has required fields
if ! grep -q "PrivateKey" "$WG_CONF" || ! grep -q "PublicKey" "$WG_CONF"; then
    echo "  ❌ ERROR: WireGuard config is invalid (missing keys)!"
    exit 1
fi

# Copy WireGuard config to Application Support
cp "$WG_CONF" "$APP_SUPPORT/"
echo "  ✓ WireGuard config installed to Application Support"

# Also copy WireGuard config to Desktop for easy import into CapybaraWG
DESKTOP="$USER_HOME/Desktop"
cp "$WG_CONF" "$DESKTOP/CapybaraWG-${USERNAME}.conf"
chown ${SUDO_USER}:staff "$DESKTOP/CapybaraWG-${USERNAME}.conf"
echo "  ✓ WireGuard config copied to Desktop: CapybaraWG-${USERNAME}.conf"

# Set correct ownership
chown -R ${SUDO_USER}:staff "$APP_SUPPORT"

# Install LaunchDaemon for udp2raw (enables CapybaraWG GUI to work)
if [ -f "/tmp/capybara-vpn-install/com.capybara.udp2raw.plist" ]; then
    cp "/tmp/capybara-vpn-install/com.capybara.udp2raw.plist" "/Library/LaunchDaemons/"
    chmod 644 "/Library/LaunchDaemons/com.capybara.udp2raw.plist"
    chown root:wheel "/Library/LaunchDaemons/com.capybara.udp2raw.plist"

    # Start the LaunchDaemon
    launchctl load "/Library/LaunchDaemons/com.capybara.udp2raw.plist" 2>/dev/null || true

    echo "  ✓ udp2raw LaunchDaemon installed and started"
    echo "     CapybaraWG will now work automatically!"
else
    echo "  ⚠️  WARNING: LaunchDaemon not found - CapybaraWG may require manual udp2raw start"
fi

# Clean up temp directory
rm -rf /tmp/capybara-vpn-install

# Install udp2raw if not present
if [ ! -f "$INSTALL_DIR/udp2raw" ]; then
    echo "Installing udp2raw from bundle..."

    # Check for embedded binaries
    if [ -f "/tmp/udp2raw" ]; then
        cp /tmp/udp2raw "$INSTALL_DIR/udp2raw"
        chmod +x "$INSTALL_DIR/udp2raw"
        echo "  ✓ udp2raw installed successfully"
    elif [ -f "/tmp/udp2raw_mp" ]; then
        cp /tmp/udp2raw_mp "$INSTALL_DIR/udp2raw"
        chmod +x "$INSTALL_DIR/udp2raw"
        echo "  ✓ udp2raw installed successfully"
    else
        echo "  ❌ ERROR: Bundled udp2raw binary not found!"
        echo "     This installer package may be corrupted."
        echo "     Please re-download the installer."
        exit 1
    fi
else
    echo "udp2raw already installed (keeping existing installation)"
fi

# Install WireGuard CLI tools if not present
if [ ! -f "$INSTALL_DIR/wg-quick" ]; then
    echo "WireGuard tools not found. Installing from bundle..."

    # Check for bundled binaries
    if [ -f "/tmp/wg" ] && [ -f "/tmp/wg-quick" ]; then
        cp /tmp/wg "$INSTALL_DIR/wg"
        cp /tmp/wg-quick "$INSTALL_DIR/wg-quick"
        chmod +x "$INSTALL_DIR/wg"
        chmod +x "$INSTALL_DIR/wg-quick"

        # Mark that we installed WireGuard (for uninstaller)
        touch "$APP_SUPPORT/.capybara_installed_wireguard"
        chown ${SUDO_USER}:staff "$APP_SUPPORT/.capybara_installed_wireguard"

        echo "  ✓ WireGuard tools installed successfully"
    else
        echo "  ❌ ERROR: Bundled WireGuard binaries not found!"
        echo "     This installer package may be corrupted."
        echo "     Please re-download the installer."
        exit 1
    fi
else
    echo "WireGuard tools already installed (keeping existing installation)"
fi

# Make launcher executable
chmod +x "$APP_DIR/Capybara VPN.app/Contents/MacOS/vpn-launcher"

# Make uninstaller executable
chmod +x "$APP_DIR/Uninstall Capybara VPN.app/Contents/MacOS/uninstall"

echo "Installation complete!"
echo ""
echo "Capybara VPN has been installed."
echo "Launch from Applications folder or Spotlight."
echo ""
echo "To uninstall, double-click:"
echo "  /Applications/Uninstall Capybara VPN.app"

exit 0
