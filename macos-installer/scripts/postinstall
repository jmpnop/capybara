#!/bin/bash
# Post-installation script for Capybara VPN
# This runs with root privileges after package installation

set -e

INSTALL_DIR="/usr/local/bin"
APP_DIR="/Applications"
USER_HOME=$(eval echo ~${SUDO_USER})
APP_SUPPORT="$USER_HOME/Library/Application Support/CapybaraVPN"

echo "Installing Capybara VPN..."

# Create application support directory
mkdir -p "$APP_SUPPORT"
chown ${SUDO_USER}:staff "$APP_SUPPORT"

# Move configs to application support (they're in /tmp/capybara-vpn-install/)
if [ -d "/tmp/capybara-vpn-install" ]; then
    cp /tmp/capybara-vpn-install/config.txt "$APP_SUPPORT/"
    cp /tmp/capybara-vpn-install/*_wireguard.conf "$APP_SUPPORT/" 2>/dev/null || true
    chown -R ${SUDO_USER}:staff "$APP_SUPPORT"
    rm -rf /tmp/capybara-vpn-install
fi

# Install udp2raw if not present
if [ ! -f "$INSTALL_DIR/udp2raw" ]; then
    echo "Installing udp2raw..."

    # Check for embedded binary first (works for both architectures if builder had it)
    if [ -f "/tmp/udp2raw" ]; then
        echo "  Using embedded udp2raw binary"
        cp /tmp/udp2raw "$INSTALL_DIR/udp2raw"
        chmod +x "$INSTALL_DIR/udp2raw"
    elif [ -f "/tmp/udp2raw_mp" ]; then
        echo "  Using embedded udp2raw_mp binary"
        cp /tmp/udp2raw_mp "$INSTALL_DIR/udp2raw"
        chmod +x "$INSTALL_DIR/udp2raw"
    else
        # No embedded binary - try Homebrew paths
        ARCH=$(uname -m)
        echo "  No embedded binary found, checking Homebrew..."

        if [ "$ARCH" = "arm64" ]; then
            # Apple Silicon
            if [ -f "/opt/homebrew/opt/udp2raw-multiplatform/bin/udp2raw_mp" ]; then
                echo "  Creating symlink to Homebrew udp2raw"
                ln -sf /opt/homebrew/opt/udp2raw-multiplatform/bin/udp2raw_mp "$INSTALL_DIR/udp2raw"
            else
                echo "  ⚠️  Warning: udp2raw not found!"
                echo "     Install with: brew install udp2raw-multiplatform"
            fi
        else
            # Intel Mac
            if [ -f "/usr/local/opt/udp2raw-multiplatform/bin/udp2raw_mp" ]; then
                echo "  Creating symlink to Homebrew udp2raw"
                ln -sf /usr/local/opt/udp2raw-multiplatform/bin/udp2raw_mp "$INSTALL_DIR/udp2raw"
            else
                echo "  ⚠️  Warning: udp2raw not found!"
                echo "     Install with: brew install udp2raw-multiplatform"
            fi
        fi
    fi
else
    echo "udp2raw already installed at $INSTALL_DIR/udp2raw"
fi

# Install WireGuard CLI tools if not present
if [ ! -f "$INSTALL_DIR/wg-quick" ]; then
    echo "WireGuard tools not found. Attempting to install..."

    # Check if Homebrew is installed
    if command -v brew >/dev/null 2>&1; then
        echo "  Installing wireguard-tools via Homebrew..."
        sudo -u ${SUDO_USER} brew install wireguard-tools 2>&1 | grep -v "^=" || true

        # Verify installation
        if [ -f "$INSTALL_DIR/wg-quick" ]; then
            echo "  ✓ WireGuard tools installed successfully"
        else
            echo "  ⚠️  WireGuard installation may have failed"
            echo "     Verify with: wg-quick --version"
        fi
    else
        echo "  ⚠️  Homebrew not found. Please install WireGuard manually:"
        echo "     App Store: https://apps.apple.com/us/app/wireguard/id1451685025"
        echo "     Or install Homebrew first: https://brew.sh"
    fi
else
    echo "WireGuard tools already installed"
fi

# Make launcher executable
chmod +x "$APP_DIR/Capybara VPN.app/Contents/MacOS/vpn-launcher"

# Make uninstaller executable
chmod +x "$APP_DIR/Uninstall Capybara VPN.app/Contents/MacOS/uninstall"

echo "Installation complete!"
echo ""
echo "Capybara VPN has been installed."
echo "Launch from Applications folder or Spotlight."
echo ""
echo "To uninstall, double-click:"
echo "  /Applications/Uninstall Capybara VPN.app"

exit 0
